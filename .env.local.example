# New open-mint app: xAI API credentials, NOT X OAuth credentials.
XAI_API_KEY=
# Server-only X API app-only Bearer Token. Required before new real mint preparation.
# Keep the actual token in ignored .env.local; never expose it in browser code.
OPEN_MINT_X_BEARER_TOKEN=
OPEN_MINT_GROK_MODEL=grok-4.6
OPEN_MINT_DAILY_ASSESSMENT_LIMIT=25
# PORT=3000
# OPEN_MINT_ORIGIN=http://127.0.0.1:3000
# OPEN_MINT_RPC_PORT=18546
# OPEN_MINT_DATA_DIR=.local/open-mint/grok

# Historical X-claim application only: local:serve and local:auth:check.
# Use a separate X development app: OAuth 2.0, Web App (confidential client).
# Register this callback exactly; use 127.0.0.1, not localhost.
LOCAL_APP_PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
X_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/auth/x/callback
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_IDENTITY_DAILY_CALL_LIMIT=100

# Explicit choice; local:serve:x overrides this with real.
# local:serve:emulator always selects the simulator, ignoring X credentials.
LOCAL_X_AUTH_MODE=emulator
