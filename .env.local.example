# Copy to .env.local. This file is loaded by local:serve and local:auth:check.
# Use a separate X development app: OAuth 2.0, Web App (confidential client).
# Register this callback exactly; use 127.0.0.1, not localhost.
LOCAL_APP_PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
X_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/auth/x/callback
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_IDENTITY_DAILY_CALL_LIMIT=100

# Explicit choice; local:serve:x overrides this with real.
# local:serve:emulator always selects the simulator, ignoring X credentials.
LOCAL_X_AUTH_MODE=emulator
